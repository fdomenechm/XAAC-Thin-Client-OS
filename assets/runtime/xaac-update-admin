#!/usr/bin/python3
"""Secure update administration for phases 10.1 and 10.2."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath
from typing import Any

RUNTIME_DIR = Path(__file__).resolve().parent
LIBEXEC_DIR = Path("/usr/local/libexec")
for candidate in (RUNTIME_DIR, LIBEXEC_DIR):
    if str(candidate) not in sys.path:
        sys.path.insert(0, str(candidate))
try:
    import xaac_update_runtime as update_runtime
except ImportError as exc:
    update_runtime = None  # type: ignore[assignment]
    _RUNTIME_IMPORT_ERROR = exc
else:
    _RUNTIME_IMPORT_ERROR = None

try:
    import xaac_base_os_update_runtime as base_os_runtime
except ImportError as exc:
    base_os_runtime = None  # type: ignore[assignment]
    _BASE_OS_RUNTIME_IMPORT_ERROR = exc
else:
    _BASE_OS_RUNTIME_IMPORT_ERROR = None

POLICY_PATH = Path("/etc/xaac/update/policy.json")
STATE_PATH = Path("/var/lib/xaac-update/state.json")
CURRENT_RELEASE_PATH = Path("/usr/share/xaac/update/current-release.json")


class UpdateAdminError(RuntimeError):
    pass


def _run(command: list[str], *, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        raise UpdateAdminError(f"No s'ha pogut executar {command[0]}: {exc}") from exc


def _load_json(path: Path, description: str) -> dict[str, Any]:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise UpdateAdminError(f"No s'ha pogut llegir {description}: {exc}") from exc
    if not isinstance(raw, dict):
        raise UpdateAdminError(f"{description} invàlid")
    return raw


def _load_policy() -> dict[str, Any]:
    policy = _load_json(POLICY_PATH, "la política d'actualització")
    if policy.get("schema_version") != 2 or policy.get("model_id") != "xaac-update-architecture-v1":
        raise UpdateAdminError("Política d'actualització no compatible")
    return policy


def _os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = Path("/etc/os-release").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise UpdateAdminError(f"No s'ha pogut llegir /etc/os-release: {exc}") from exc
    for line in lines:
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value.strip().strip('"')
    return values


def _installed_version(package: str) -> str | None:
    result = _run(["/usr/bin/dpkg-query", "-W", "-f=${Status}\n${Version}\n", package])
    if result.returncode != 0:
        return None
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(lines) != 2 or lines[0] != "install ok installed":
        return None
    return lines[1]


def _architecture() -> str:
    result = _run(["/usr/bin/dpkg", "--print-architecture"])
    if result.returncode != 0 or not result.stdout.strip():
        raise UpdateAdminError("No s'ha pogut determinar l'arquitectura Debian")
    return result.stdout.strip()


def _compare_versions(left: str, relation: str, right: str) -> bool:
    result = _run(["/usr/bin/dpkg", "--compare-versions", left, relation, right])
    return result.returncode == 0


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _canonical_json(payload: object) -> bytes:
    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )


def _manifest_payload_hash(payload: dict[str, Any]) -> str:
    clean = {key: value for key, value in payload.items() if key != "integrity"}
    return hashlib.sha256(_canonical_json(clean)).hexdigest()


def _component_status(policy: dict[str, Any]) -> list[dict[str, object]]:
    return [
        {
            "id": component["id"],
            "package": component["package"],
            "installed_version": _installed_version(component["package"]),
            "critical": component["critical"],
        }
        for component in policy["components"]
    ]


def status_payload() -> dict[str, object]:
    policy = _load_policy()
    os_release = _os_release()
    state: dict[str, Any] | None = None
    if STATE_PATH.is_file():
        state = _load_json(STATE_PATH, "l'estat d'actualització")
    current_release: dict[str, Any] | None = None
    if CURRENT_RELEASE_PATH.is_file():
        current_release = _load_json(CURRENT_RELEASE_PATH, "el manifest de la versió instal·lada")
    return {
        "status": "ok",
        "phase": "10.2",
        "os": {
            "id": os_release.get("ID"),
            "version": os_release.get("VERSION_ID"),
            "architecture": _architecture(),
            "hardware_profile": policy["hardware_profile"],
        },
        "components": _component_status(policy),
        "update_state": state,
        "current_release": current_release.get("release") if current_release else None,
        "installation_enabled": Path(policy["manifest"]["keyring"]).is_file(),
    }


def preflight_payload() -> tuple[dict[str, object], bool]:
    policy = _load_policy()
    checks: list[dict[str, object]] = []
    os_release = _os_release()
    expected_id = policy["preflight"]["require_os_identity"]
    os_ok = os_release.get("ID") == expected_id
    checks.append({"name": "os_identity", "ok": os_ok, "value": os_release.get("ID")})

    architecture = _architecture()
    arch_ok = architecture == policy["architecture"]
    checks.append({"name": "architecture", "ok": arch_ok, "value": architecture})

    free_bytes = shutil.disk_usage("/var").free
    minimum_free = int(policy["preflight"]["minimum_free_bytes"])
    checks.append(
        {
            "name": "free_space",
            "ok": free_bytes >= minimum_free,
            "free_bytes": free_bytes,
            "required_bytes": minimum_free,
        }
    )

    audit = _run(["/usr/bin/dpkg", "--audit"])
    audit_ok = audit.returncode == 0 and not audit.stdout.strip() and not audit.stderr.strip()
    checks.append(
        {
            "name": "dpkg_audit",
            "ok": audit_ok,
            "detail": (audit.stdout + audit.stderr).strip() or None,
        }
    )

    apt = _run(["/usr/bin/apt-get", "-o", "Debug::NoLocking=true", "check"], timeout=120)
    apt_ok = apt.returncode == 0
    checks.append(
        {
            "name": "apt_check",
            "ok": apt_ok,
            "detail": (apt.stderr or apt.stdout).strip()[-1000:] or None,
        }
    )

    missing_packages = [
        component["package"]
        for component in policy["components"]
        if _installed_version(component["package"]) is None
    ]
    checks.append(
        {
            "name": "xaac_components",
            "ok": not missing_packages,
            "missing": missing_packages,
        }
    )

    keyring = Path(policy["manifest"]["keyring"])
    checks.append(
        {
            "name": "update_trust_keyring",
            "ok": keyring.is_file(),
            "path": str(keyring),
            "required_for_check": True,
        }
    )

    ok = all(bool(item["ok"]) for item in checks)
    return {"status": "ok" if ok else "failed", "phase": "10.2", "checks": checks}, ok


def _require_root() -> None:
    if os.geteuid() != 0:
        raise UpdateAdminError("Aquesta ordre requereix privilegis d'administrador (sudo)")


def _verify_signature(policy: dict[str, Any], manifest: Path, signature: Path) -> None:
    keyring = Path(policy["manifest"]["keyring"])
    if not keyring.is_file():
        raise UpdateAdminError(
            f"No existeix el keyring de confiança {keyring}; la verificació es bloqueja de forma segura"
        )
    if not signature.is_file():
        raise UpdateAdminError(f"Falta la signatura separada: {signature}")
    result = _run(["/usr/bin/gpgv", "--keyring", str(keyring), str(signature), str(manifest)])
    if result.returncode != 0:
        raise UpdateAdminError("La signatura criptogràfica del manifest no és vàlida")


def _safe_bundle_file(bundle: Path, filename: object) -> Path:
    if not isinstance(filename, str) or not filename:
        raise UpdateAdminError("Nom d'artefacte invàlid al manifest")
    relative = PurePosixPath(filename)
    if relative.is_absolute() or ".." in relative.parts or len(relative.parts) != 1:
        raise UpdateAdminError(f"Nom d'artefacte insegur: {filename}")
    root = bundle.resolve()
    path = (root / filename).resolve()
    try:
        path.relative_to(root)
    except ValueError as exc:
        raise UpdateAdminError(f"L'artefacte ix del bundle: {filename}") from exc
    if not path.is_file() or path.is_symlink():
        raise UpdateAdminError(f"Artefacte absent o insegur: {filename}")
    return path


def _deb_metadata(path: Path) -> tuple[str, str, str]:
    result = _run(["/usr/bin/dpkg-deb", "-W", "--showformat=${Package}\n${Version}\n${Architecture}\n", str(path)])
    if result.returncode != 0:
        raise UpdateAdminError(f"Paquet Debian invàlid: {path.name}")
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(lines) != 3:
        raise UpdateAdminError(f"Metadades Debian incompletes: {path.name}")
    return lines[0], lines[1], lines[2]


def verify_manifest(manifest_path: Path, signature_path: Path, bundle: Path) -> dict[str, object]:
    _require_root()
    policy = _load_policy()
    preflight, ok = preflight_payload()
    if not ok:
        raise UpdateAdminError("El preflight del terminal ha fallat")
    _verify_signature(policy, manifest_path, signature_path)
    manifest = _load_json(manifest_path, "el manifest d'actualització")
    if manifest.get("schema") != policy["manifest"]["schema"]:
        raise UpdateAdminError("Esquema de manifest no compatible")
    integrity = manifest.get("integrity")
    if not isinstance(integrity, dict) or integrity.get("algorithm") != "sha256":
        raise UpdateAdminError("Integritat interna del manifest absent")
    expected_manifest_hash = integrity.get("manifest_payload")
    if not isinstance(expected_manifest_hash, str) or _manifest_payload_hash(manifest) != expected_manifest_hash:
        raise UpdateAdminError("El hash intern del manifest no coincideix")

    release = manifest.get("release")
    compatibility = manifest.get("compatibility")
    components = manifest.get("components")
    if not isinstance(release, dict) or not isinstance(compatibility, dict) or not isinstance(components, list):
        raise UpdateAdminError("Manifest d'actualització incomplet")
    if release.get("hardware_profile") != policy["hardware_profile"]:
        raise UpdateAdminError("El manifest no correspon al perfil de maquinari")
    if release.get("architecture") != policy["architecture"]:
        raise UpdateAdminError("El manifest no correspon a l'arquitectura")
    if release.get("channel") not in [item["id"] for item in policy["channels"]]:
        raise UpdateAdminError("Canal d'actualització no autoritzat")

    os_release = _os_release()
    installed_os = os_release.get("VERSION_ID")
    target_os = release.get("os_version")
    minimum_os = compatibility.get("minimum_installed_os_version")
    if not all(isinstance(value, str) and value for value in (installed_os, target_os, minimum_os)):
        raise UpdateAdminError("Versions de sistema incompletes al manifest")
    assert isinstance(installed_os, str) and isinstance(target_os, str) and isinstance(minimum_os, str)
    if not _compare_versions(installed_os, "ge", minimum_os):
        raise UpdateAdminError("La versió instal·lada és massa antiga per a aquesta actualització")
    if target_os != installed_os:
        raise UpdateAdminError(
            "La fase 10.2 només actualitza el conjunt de components XAAC; "
            "el manifest ha de correspondre exactament al VERSION_ID instal·lat"
        )

    expected_components = {item["id"]: item for item in policy["components"]}
    if {item.get("id") for item in components if isinstance(item, dict)} != set(expected_components):
        raise UpdateAdminError("El manifest no conté el conjunt complet de components XAAC")

    verified: list[dict[str, object]] = []
    for item in components:
        if not isinstance(item, dict):
            raise UpdateAdminError("Component invàlid al manifest")
        component_id = item.get("id")
        if not isinstance(component_id, str) or component_id not in expected_components:
            raise UpdateAdminError("Component desconegut al manifest")
        expected = expected_components[component_id]
        path = _safe_bundle_file(bundle, item.get("filename"))
        digest = item.get("sha256")
        if not isinstance(digest, str) or len(digest) != 64 or _sha256(path) != digest:
            raise UpdateAdminError(f"SHA-256 incorrecte per a {path.name}")
        package, version, architecture = _deb_metadata(path)
        if package != expected["package"] or package != item.get("package"):
            raise UpdateAdminError(f"Nom de paquet incorrecte en {path.name}")
        if version != item.get("version") or architecture != item.get("architecture"):
            raise UpdateAdminError(f"Metadades Debian incoherents en {path.name}")
        if architecture != expected["architecture"]:
            raise UpdateAdminError(f"Arquitectura no autoritzada en {path.name}")
        installed = _installed_version(package)
        if installed is None:
            raise UpdateAdminError(f"El component crític {package} no està instal·lat")
        if not _compare_versions(version, "ge", installed):
            raise UpdateAdminError(f"Downgrade del paquet {package} bloquejat")
        verified.append(
            {
                "id": component_id,
                "package": package,
                "installed_version": installed,
                "candidate_version": version,
                "sha256": digest,
            }
        )

    payload = {
        "status": "verified",
        "phase": "10.2",
        "manifest": str(manifest_path.resolve()),
        "manifest_sha256": _sha256(manifest_path),
        "target_os_version": target_os,
        "components": verified,
        "installation_enabled": True,
        "preflight": preflight,
    }
    _record_check(policy, payload)
    return payload


def _audit_event(event: str, data: dict[str, Any]) -> None:
    policy = _load_policy()
    audit_path = Path(policy["audit"]["path"])
    audit_path.parent.mkdir(parents=True, exist_ok=True)
    record = {"timestamp": datetime.now(timezone.utc).isoformat(), "event": event, **data}
    with audit_path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
    os.chmod(audit_path, 0o640)


def _record_check(policy: dict[str, Any], payload: dict[str, object]) -> None:
    state = {
        "schema_version": 2,
        "model_id": policy["model_id"],
        "phase": "10.2",
        "status": "available",
        "last_check": datetime.now(timezone.utc).isoformat(),
        "last_manifest_sha256": payload["manifest_sha256"],
        "available_os_version": payload["target_os_version"],
        "last_error": None,
    }
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE_PATH.with_name(f".{STATE_PATH.name}.{os.getpid()}")
    temporary.write_text(json.dumps(state, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o640)
    os.replace(temporary, STATE_PATH)

    audit_path = Path(policy["audit"]["path"])
    audit_path.parent.mkdir(parents=True, exist_ok=True)
    event = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "event": "manifest_verified",
        "manifest_sha256": payload["manifest_sha256"],
        "target_os_version": payload["target_os_version"],
        "components": payload["components"],
    }
    with audit_path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
    os.chmod(audit_path, 0o640)


def _print_human(payload: dict[str, object]) -> None:
    if payload.get("phase") == "10.6":
        if "packages" in payload:
            print(f"Sistema base Debian 13: {payload.get('status')}")
            print(f"Paquets a modificar: {payload.get('changed_packages', 0)}")
            print(f"Dependències noves: {payload.get('new_packages', 0)}")
            print("Reinici recomanat: sí" if payload.get("reboot_recommended") else "Reinici recomanat: no")
            return
        if "suite" in payload:
            print(f"{payload.get('os')} — Debian {payload.get('debian_version')} ({payload.get('architecture')})")
            print(f"Suite APT controlada: {payload.get('suite')}")
            print("Actualitzacions automàtiques: deshabilitades")
            print("full-upgrade/dist-upgrade: BLOQUEJATS")
            print("Reinici pendent: sí" if payload.get("reboot_required") else "Reinici pendent: no")
            return
    if payload.get("phase") == "10.2" and "os" in payload:
        os_info = payload["os"]
        assert isinstance(os_info, dict)
        print(f"XAAC Thin Client OS {os_info.get('version')} ({os_info.get('architecture')})")
        print(f"Perfil: {os_info.get('hardware_profile')}")
        for component in payload.get("components", []):
            if isinstance(component, dict):
                print(f"{component.get('package')}: {component.get('installed_version') or 'NO INSTAL·LAT'}")
        print("Instal·lació d'actualitzacions: habilitada" if payload.get("installation_enabled") else "Instal·lació d'actualitzacions: BLOQUEJADA (falta keyring de releases)")
        return
    if "checks" in payload:
        for check in payload["checks"]:  # type: ignore[index]
            if isinstance(check, dict):
                marker = "OK" if check.get("ok") else "ERROR"
                print(f"[{marker}] {check.get('name')}")
        return
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="xaac-update-admin", description="Administració segura d'actualitzacions XAAC")
    parser.add_argument("--json", action="store_true", help="Mostra l'eixida en JSON")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status", help="Mostra versions i estat de l'arquitectura d'actualització")
    subparsers.add_parser("preflight", help="Comprova si el terminal està preparat per actualitzar-se")
    check = subparsers.add_parser("check", help="Verifica origen, integritat i compatibilitat d'un bundle signat")
    check.add_argument("manifest", type=Path, help="Manifest JSON del bundle")
    check.add_argument("--signature", type=Path, help="Signatura OpenPGP separada (.asc)")
    check.add_argument("--bundle", type=Path, help="Directori que conté els paquets .deb")
    update = subparsers.add_parser("update", help="Verifica i instal·la transaccionalment un bundle signat")
    update.add_argument("manifest", type=Path, help="Manifest JSON del bundle")
    update.add_argument("--signature", type=Path, help="Signatura OpenPGP separada (.asc)")
    update.add_argument("--bundle", type=Path, help="Directori que conté els paquets .deb")
    update.add_argument("--yes", action="store_true", help="Confirma explícitament la instal·lació")
    rollback = subparsers.add_parser("rollback", help="Restaura l'últim punt de recuperació funcional")
    rollback.add_argument("--yes", action="store_true", help="Confirma explícitament el rollback")
    subparsers.add_parser("os-status", help="Mostra l'estat de l'actualització controlada de Debian 13")
    subparsers.add_parser("os-check", help="Actualitza índexs i simula l'upgrade segur de Debian 13")
    os_update = subparsers.add_parser("os-update", help="Aplica l'upgrade controlat del sistema base Debian 13")
    os_update.add_argument("--yes", action="store_true", help="Confirma explícitament l'actualització del sistema base")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "status":
            payload = status_payload()
            ok = True
        elif args.command == "preflight":
            payload, ok = preflight_payload()
        elif args.command == "check":
            manifest = args.manifest.resolve()
            signature = (args.signature or Path(str(manifest) + ".asc")).resolve()
            bundle = (args.bundle or manifest.parent).resolve()
            payload = verify_manifest(manifest, signature, bundle)
            ok = True
        elif args.command == "update":
            if not args.yes:
                raise UpdateAdminError("Cal confirmar explícitament l'actualització amb --yes")
            _require_root()
            if update_runtime is None:
                raise UpdateAdminError(f"Runtime transaccional no disponible: {_RUNTIME_IMPORT_ERROR}")
            manifest = args.manifest.resolve()
            signature = (args.signature or Path(str(manifest) + ".asc")).resolve()
            bundle = (args.bundle or manifest.parent).resolve()
            verified = verify_manifest(manifest, signature, bundle)
            payload = update_runtime.apply_update(
                manifest, signature, bundle, audit=_audit_event
            )
            payload["verification"] = {
                "manifest_sha256": verified["manifest_sha256"],
                "target_os_version": verified["target_os_version"],
            }
            ok = payload.get("status") == "confirmed"
        elif args.command == "rollback":
            if not args.yes:
                raise UpdateAdminError("Cal confirmar explícitament el rollback amb --yes")
            _require_root()
            if update_runtime is None:
                raise UpdateAdminError(f"Runtime transaccional no disponible: {_RUNTIME_IMPORT_ERROR}")
            payload = update_runtime.manual_rollback(audit=_audit_event)
            ok = payload.get("status") == "rolled_back"
        elif args.command == "os-status":
            _require_root()
            if base_os_runtime is None:
                raise UpdateAdminError(f"Runtime del sistema base no disponible: {_BASE_OS_RUNTIME_IMPORT_ERROR}")
            payload = base_os_runtime.status(base_os_runtime.load_policy())
            ok = True
        elif args.command == "os-check":
            _require_root()
            if base_os_runtime is None:
                raise UpdateAdminError(f"Runtime del sistema base no disponible: {_BASE_OS_RUNTIME_IMPORT_ERROR}")
            payload = base_os_runtime.check_updates(base_os_runtime.load_policy(), refresh=True)
            ok = True
        elif args.command == "os-update":
            if not args.yes:
                raise UpdateAdminError("Cal confirmar explícitament l'actualització del sistema base amb --yes")
            _require_root()
            if base_os_runtime is None:
                raise UpdateAdminError(f"Runtime del sistema base no disponible: {_BASE_OS_RUNTIME_IMPORT_ERROR}")
            payload = base_os_runtime.apply_update(base_os_runtime.load_policy())
            ok = payload.get("status") in {"completed", "current"}
        else:
            raise UpdateAdminError("Ordre administrativa no suportada")
    except UpdateAdminError as exc:
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "error": str(exc)}, ensure_ascii=False))
        else:
            print(f"Error: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        _print_human(payload)
    return 0 if ok else 4


if __name__ == "__main__":
    raise SystemExit(main())
