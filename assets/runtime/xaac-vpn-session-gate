#!/bin/sh
set -eu
CONFIG=/etc/xaac/vpn-manager.toml
VPN_APP=/usr/bin/xaac-thin-client-vpn
THIN_CLIENT=/usr/local/libexec/xaac-thin-client-launch
POLICY=optional
if [ -r "$CONFIG" ]; then
    configured=$(awk -F '"' '/^[ 	]*policy[ 	]*=/ { print $2; exit }' "$CONFIG" 2>/dev/null || true)
    [ -n "$configured" ] && POLICY=$configured
fi
case "$POLICY" in
    disabled) exec "$THIN_CLIENT" ;;
    optional|required) ;;
    *) echo "ERROR: política VPN desconeguda: $POLICY" >&2; exit 2 ;;
esac
if "$VPN_APP"; then rc=0; else rc=$?; fi
case "$rc" in
    0) exec "$THIN_CLIENT" ;;
    10)
        if [ "$POLICY" = optional ]; then exec "$THIN_CLIENT"; fi
        echo "ERROR: la VPN és obligatòria i no es pot ometre." >&2
        exit 10 ;;
    *) exit "$rc" ;;
esac
