#!/bin/bash
set -Eeuo pipefail
export LANG=ca_ES.UTF-8
export LC_ALL=ca_ES.UTF-8
SOURCE_DIR=/run/live/medium/live
ROOTFS="$SOURCE_DIR/filesystem.squashfs"
HASH="$SOURCE_DIR/filesystem.squashfs.sha256"
MNT=/mnt/xaac-target
cleanup() {
  set +e
  for p in run sys proc dev/pts dev boot/efi; do mountpoint -q "$MNT/$p" && umount -R "$MNT/$p"; done
  mountpoint -q "$MNT" && umount "$MNT"
}
trap cleanup EXIT
fail(){ echo; echo "ERROR: $*" >&2; echo "La instal·lació no ha finalitzat." >&2; read -r -p "Premeu Retorn per obrir una consola..." _ || true; exec /bin/bash; }
[[ $EUID -eq 0 ]] || fail "cal executar l'instal·lador com a root"
[[ -f "$ROOTFS" && -f "$HASH" ]] || fail "no s'ha trobat el sistema d'instal·lació"
(cd "$SOURCE_DIR" && sha256sum -c "$(basename "$HASH")") || fail "la verificació SHA-256 ha fallat"
mapfile -t DISKS < <(lsblk -dpno NAME,TYPE,RM,SIZE | awk '$2=="disk" && $3==0 {print $1" "$4}')
((${#DISKS[@]})) || fail "no s'ha detectat cap disc intern"
clear
echo "XAAC Thin Client OS — Instal·lador"
echo "=================================="
echo
echo "ATENCIÓ: el disc seleccionat s'esborrarà completament."
echo
for i in "${!DISKS[@]}"; do printf '  %d) %s\n' "$((i+1))" "${DISKS[$i]}"; done
read -r -p "Seleccioneu el disc de destinació: " CHOICE
[[ "$CHOICE" =~ ^[0-9]+$ ]] && ((CHOICE>=1 && CHOICE<=${#DISKS[@]})) || fail "selecció de disc invàlida"
TARGET=${DISKS[$((CHOICE-1))]%% *}
[[ $(blockdev --getsize64 "$TARGET") -ge $((7168*1024*1024)) ]] || fail "el disc ha de tindre almenys 7 GiB"
findmnt -rn -S "$TARGET" >/dev/null && fail "el disc de destinació està muntat"
echo; echo "Disc seleccionat: $TARGET"; read -r -p 'Escriviu exactament INSTALL XAAC per continuar: ' CONFIRM
[[ "$CONFIRM" == "INSTALL XAAC" ]] || fail "confirmació cancel·lada"
echo "Particionant $TARGET..."
wipefs -af "$TARGET"; sgdisk --zap-all "$TARGET"
sgdisk -n 1:1MiB:+2MiB -t 1:ef02 -c 1:XAAC_BIOS "$TARGET"
sgdisk -n 2:0:+256MiB -t 2:ef00 -c 2:XAAC_EFI "$TARGET"
sgdisk -n 3:0:+4608MiB -t 3:8300 -c 3:XAAC_ROOT "$TARGET"
sgdisk -n 4:0:+1024MiB -t 4:8300 -c 4:XAAC_DATA "$TARGET"
sgdisk -n 5:0:0 -t 5:8300 -c 5:XAAC_RECOVERY "$TARGET"
partprobe "$TARGET"; udevadm settle
case "$TARGET" in /dev/mmcblk*|/dev/nvme*) P="${TARGET}p";; *) P="$TARGET";; esac
mkfs.vfat -F32 -n XAAC_EFI "${P}2"
mkfs.ext4 -F -L XAAC_ROOT "${P}3"
mkfs.ext4 -F -L XAAC_DATA "${P}4"
mkfs.ext4 -F -L XAAC_RECOVERY "${P}5"
mkdir -p "$MNT"; mount "${P}3" "$MNT"
echo "Copiant el sistema..."; unsquashfs -f -d "$MNT" "$ROOTFS" >/dev/null
mkdir -p "$MNT/boot/efi" "$MNT/var/lib/xaac" "$MNT/recovery"
mount "${P}2" "$MNT/boot/efi"
ROOT_UUID=$(blkid -s UUID -o value "${P}3"); EFI_UUID=$(blkid -s UUID -o value "${P}2"); DATA_UUID=$(blkid -s UUID -o value "${P}4"); REC_UUID=$(blkid -s UUID -o value "${P}5")
cat > "$MNT/etc/fstab" <<FSTAB
UUID=$ROOT_UUID / ext4 defaults,noatime,errors=remount-ro 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1
UUID=$DATA_UUID /var/lib/xaac ext4 defaults,noatime 0 2
UUID=$REC_UUID /recovery ext4 defaults,noatime 0 2
FSTAB
KVER=$(find "$MNT/lib/modules" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -V | tail -1)
[[ -n "$KVER" ]] || fail "no s'ha trobat el kernel instal·lat"
cp "$SOURCE_DIR/vmlinuz" "$MNT/boot/vmlinuz-$KVER"; cp "$SOURCE_DIR/initrd.img" "$MNT/boot/initrd.img-$KVER"
for d in dev dev/pts proc sys run; do mount --rbind "/$d" "$MNT/$d"; mount --make-rslave "$MNT/$d"; done
rm -f "$MNT/etc/machine-id"; touch "$MNT/etc/machine-id"
chroot "$MNT" grub-install --target=i386-pc --recheck "$TARGET"
chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=XAAC --removable --no-nvram
chroot "$MNT" update-grub
touch "$MNT/etc/xaac-first-boot.pending"
sync
echo; echo "Instal·lació completada correctament en $TARGET."
echo "Retireu la ISO i premeu Retorn per reiniciar."
read -r _
reboot
